
import numpy as np
import timeit

# Simulated network latency readings in milliseconds
rng = np.random.default_rng(42)
latency_ms = rng.uniform(5, 250, 1_000_000)


# Method 1: Using a normal Python loop
def loop_version():
    squared = []

    for value in latency_ms:
        seconds = value / 1000.0
        squared.append(seconds ** 2)

    return squared


# Method 2: Using NumPy vectorization
def vectorized_version():
    seconds = latency_ms / 1000.0
    return seconds ** 2


# Measure execution time
loop_time = timeit.timeit(loop_version, number=1)

vector_time = timeit.timeit(
    vectorized_version,
    number=3
) / 3

# Calculate results using vectorization
result = vectorized_version()

# Display results
print("First five squared latency values:")
print(result[:5])

print(f"Loop execution time: {loop_time:.4f} seconds")
print(f"Vectorized execution time: {vector_time:.4f} seconds")

print(
    f"Approximate speed-up: "
    f"{loop_time / vector_time:.1f} times"
)
