
import numpy as np

# Four corners of a square: each row is [x, y]
points = np.array([
    [0.0, 0.0],
    [1.0, 0.0],
    [1.0, 1.0],
    [0.0, 1.0]
])

# Rotation angle: 45 degrees
angle = np.deg2rad(45)

# Rotation matrix
rotation = np.array([
    [np.cos(angle), -np.sin(angle)],
    [np.sin(angle),  np.cos(angle)]
])

# Scaling matrix
scale = np.array([
    [2.0, 0.0],
    [0.0, 1.5]
])

# Combine rotation and scaling transformations
transformation = rotation @ scale

# Transform all points
transformed_points = points @ transformation.T

# Display results
print("Original points:\n", points)
print("\nTransformation matrix:\n", transformation)
print("\nTransformed points:\n", transformed_points)
print("\nDeterminant:", np.linalg.det(transformation))
